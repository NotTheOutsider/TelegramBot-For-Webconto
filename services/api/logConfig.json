{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "file": {
      "format": "%(asctime)s - %(levelname)s (%(filename)s:%(lineno)d) %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    },
    "console": {
      "()": "services.common.log.CustomFormatter"
    }
  },
  "handlers": {
    "file_handler": {
      "class": "logging.FileHandler",
      "formatter": "file",
      "level": "INFO",
      "filename": ".log",
      "encoding": "utf-8"
    },
    "console_handler": {
      "class": "logging.StreamHandler",
      "formatter": "console",
      "level": "INFO",
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": ["console_handler", "file_handler"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "level": "INFO",
      "handlers": ["console_handler", "file_handler"],
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": ["console_handler", "file_handler"],
      "level": "INFO",
      "propagate": false
    }
  },
  "root": {
    "level": "INFO",
    "handlers": ["console_handler", "file_handler"],
    "propagate": false
  }
}